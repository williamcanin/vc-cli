groupname=veracrypt-security-exit

post_install() {
    getent group "$groupname" > /dev/null || groupadd --system "$groupname"

    cat << EOF

==> veracrypt-security-exit installed.

    1. Enable the shutdown/reboot hook:
         systemctl enable veracrypt-security-exit.service

    2. Add your user to the '$groupname' group so it can run the unmount
       script without a sudo password prompt (needed for desktop logout
       hooks):
         sudo usermod -aG $groupname \$USER
       Log out and back in for the group change to take effect.

    See the README for how to hook this into logout on Hyprland, GNOME,
    or XFCE.

EOF
}

post_upgrade() {
    post_install
}

pre_remove() {
    systemctl disable --now veracrypt-security-exit.service &> /dev/null || true
}

post_remove() {
    if getent group "$groupname" > /dev/null; then
        groupdel "$groupname" 2> /dev/null || true
    fi
}
