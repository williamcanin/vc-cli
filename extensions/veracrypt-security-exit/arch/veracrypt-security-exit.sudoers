# Installed by the veracrypt-security-exit package.
# Do not edit by hand — changes may be overwritten on upgrade.
#
# Members of the veracrypt-security-exit group may run the unmount script
# without a sudo password prompt. This is what makes desktop logout hooks
# (Hyprland keybind, systemd --user unit, etc.) work without interrupting
# the logout flow with a password prompt.
#
# Add your user to the group with:
#   sudo usermod -aG veracrypt-security-exit $USER
%veracrypt-security-exit ALL=(root) NOPASSWD: /usr/bin/veracrypt-security-exit.sh
